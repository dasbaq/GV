{
  "grid": {
    "dt_try_range": [1.0, 200.0],
    "dt_try_step": 0.1,
    "mu_try_range": [-0.99, 0.99],
    "mu_try_step": 0.02
  },
  "reconstruction": {
    "series_truncation_tol": 1.0e-6,
    "max_series_terms": 200,
